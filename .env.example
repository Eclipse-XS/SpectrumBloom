# ==============================================================================
# SpectrumBloom Configuration
# Copy to .env and adjust for local, Docker, or cloud deployment.
# ==============================================================================

# -- Application ---------------------------------------------------------------
APP_NAME=SpectrumBloom
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:4200,http://127.0.0.1:4200

# Bearer token protecting all /api/v1/* endpoints.
# Mandatory (>= 16 chars, non-placeholder) when APP_ENV=production|staging, binding a non-loopback
# API_HOST, or launching Docker Compose.
# Generate safely: python -c "import secrets; print(secrets.token_hex(32))" (or `openssl rand -hex 32`)
API_AUTH_TOKEN=

# -- Storage & Session Persistence ---------------------------------------------
# Default is local filesystem + in-memory repository (zero external infra).
DATASET_STORAGE_BACKEND=local
LOCAL_DATASET_DIR=./data/datasets
MAX_UPLOAD_MB=25
SESSION_TTL_SECONDS=86400

# Optional Redis (used only if REDIS_URL is set)
REDIS_URL=

# Optional S3-compatible object storage (MinIO, R2, GCS interop, or AWS S3)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PREFIX=datasets
S3_DELETE_ON_SESSION_DELETE=true

# -- Local-First LLM Provider --------------------------------------------------
# Supported providers: ollama | llamacpp | openai | gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=1536
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_ENABLE_THINKING=false

# Local inference endpoints
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080/v1

# Optional external provider keys (never required for local EDA)
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# -- Code Execution Sandbox (Fail-Closed) --------------------------------------
# Supported backends: docker | remote | nsjail | strict_subprocess | disabled
# - docker (default): hardened container-per-run (--network=none --read-only --cap-drop=ALL)
# - remote: separate internal sandbox-executor HTTP boundary (keeps docker.sock off API)
# - nsjail: Linux namespace/rlimit confinement (where installed)
# - disabled: disables dynamic LLM Python execution (deterministic EDA/ML/tools only)
# - strict_subprocess: process-level guard RESTRICTED to trusted local development ONLY
#   (requires APP_ENV=development|test AND ALLOW_TRUSTED_LOCAL_SUBPROCESS=true)
SANDBOX_BACKEND=docker
ALLOW_TRUSTED_LOCAL_SUBPROCESS=false
SANDBOX_TIMEOUT_SECONDS=25
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_MAX_OUTPUT_CHARS=20000
SANDBOX_DOCKER_IMAGE=spectrumbloom-sandbox:latest
SANDBOX_EXECUTOR_URL=
# Mandatory (>= 16 chars, non-placeholder) for remote sandbox / Docker Compose sandbox-executor.
# Generate a separate secret: python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_EXECUTOR_TOKEN=

# -- Observability (OpenTelemetry + Optional Langfuse) -------------------------
OTEL_SERVICE_NAME=spectrumbloom-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# -- Streamlit UI --------------------------------------------------------------
SPECTRUMBLOOM_API_URL=http://localhost:8000

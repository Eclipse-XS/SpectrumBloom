FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

COPY --from=ghcr.io/astral-sh/uv:0.6.10 /uv /bin/

WORKDIR /app
COPY src/spectrumbloom/sandbox ./src/spectrumbloom/sandbox

RUN uv pip install --system --no-cache \
      "numpy>=1.26,<3.0" \
      "pandas>=2.2,<3.0" \
      "scipy>=1.13,<2.0" \
      "scikit-learn>=1.5,<2.0" \
      "statsmodels>=0.14,<1.0" \
      "plotly>=5.24,<7.0" \
      "pyarrow>=18.0" && \
    groupadd -r sandbox && \
    useradd -r -g sandbox -d /sandbox -s /sbin/nologin sandbox && \
    mkdir -p /sandbox && chown -R sandbox:sandbox /sandbox

USER sandbox
WORKDIR /sandbox

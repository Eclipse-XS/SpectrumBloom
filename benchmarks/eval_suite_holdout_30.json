[
  {
    "id": "hold_ecom_01_filter",
    "dataset": "sample_ecommerce.csv",
    "category": "filtering",
    "thread_group": "hold_ecom_01",
    "turn_index": 1,
    "prompt": "Count how many orders have quantity <= 3 and region != 'North'.",
    "assertion": {
      "op": "filtered_count",
      "filters": [
        [
          "quantity",
          "<=",
          3
        ],
        [
          "region",
          "!=",
          "North"
        ]
      ]
    }
  },
  {
    "id": "hold_ecom_02_agg",
    "dataset": "sample_ecommerce.csv",
    "category": "aggregation",
    "thread_group": "hold_ecom_02",
    "turn_index": 1,
    "prompt": "Compute the median revenue grouped by channel for every channel.",
    "assertion": {
      "op": "groupby_all",
      "group_by": "channel",
      "metric": "revenue",
      "agg": "median"
    }
  },
  {
    "id": "hold_ecom_03_stat",
    "dataset": "sample_ecommerce.csv",
    "category": "statistical_test",
    "thread_group": "hold_ecom_03",
    "turn_index": 1,
    "prompt": "Compute the Spearman correlation and p-value between discount_pct and satisfaction_score.",
    "assertion": {
      "op": "corr",
      "method": "spearman",
      "col_a": "discount_pct",
      "col_b": "satisfaction_score"
    }
  },
  {
    "id": "hold_ecom_04_mt1",
    "dataset": "sample_ecommerce.csv",
    "category": "multi_turn",
    "thread_group": "hold_ecom_mt",
    "turn_index": 1,
    "prompt": "Which channel has the lowest total revenue?",
    "assertion": {
      "op": "groupby_bottom",
      "group_by": "channel",
      "metric": "revenue",
      "agg": "sum"
    }
  },
  {
    "id": "hold_ecom_05_mt2",
    "dataset": "sample_ecommerce.csv",
    "category": "multi_turn",
    "thread_group": "hold_ecom_mt",
    "turn_index": 2,
    "prompt": "For that channel only, what is the mean satisfaction_score?",
    "assertion": {
      "op": "bottom_group_metric",
      "group_by": "channel",
      "rank_metric": "revenue",
      "rank_agg": "sum",
      "target_metric": "satisfaction_score",
      "target_agg": "mean"
    }
  },
